# Database (MariaDB)
DB_NAME=camagru
DB_USER=camagru
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root

# Authentication
# Secret used to sign JWT tokens (use a long, random string)
JWT_SECRET=change_me_to_a_long_random_string

# Application
# Public URL, embedded in activation / password-reset emails
APP_URL=http://localhost:8080

# Mail
MAIL_FROM=no-reply@camagru.local
# SMTP relay used by msmtp (defaults to the bundled Mailpit dev inbox)
SMTP_HOST=mailpit
SMTP_PORT=1025
# Uncomment to relay through a real SMTP server instead of Mailpit
# SMTP_AUTH=on
# SMTP_TLS=on
# SMTP_USER=your_user
# SMTP_PASS=your_password
